{
	"name": "organize-apps-and-extensions",
	"version": "1.0.1",
	"description": "A Spicetify extension that combines installed extensions and custom apps into a single dropdown in Spotify's navigation bar.",
	"author": {
		"name": "CheraHamza",
		"url": "https://github.com/CheraHamza"
	},
	"scripts": {
		"build": "spicetify-creator",
		"build-local": "spicetify-creator --out=dist --minify",
		"watch": "spicetify-creator --watch"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"spicetify-creator": "^1.0.17"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.14.54": true
	}
}
